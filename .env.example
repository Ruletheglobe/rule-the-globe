# Copy to .env.local and fill in. .env.local is gitignored.

# Discord webhook for the contact / "Work with us" form.
# SERVER-SIDE ONLY: do not prefix with NEXT_PUBLIC_ or it ships to the browser.
DISCORD_WEBHOOK_URL=

